{
  "manifest_version": 3,
  "name": "Smart Risk Analyzer",
  "version": "1.0",
  "description": "Analyze Terms & Conditions for privacy risks using AI.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}